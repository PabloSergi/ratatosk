{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    // The engine's own files come along through `import type`, and they are written for Node —
    // so its globals have to resolve here even though none of them reach the browser bundle.
    "types": ["node"]
  },
  "include": ["."]
}

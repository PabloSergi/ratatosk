{
  "name": "books-toscrape",
  "version": 1,
  "url": "https://books.toscrape.com/catalogue/page-1.html",
  "wait": {
    "selector": "article.product_pod",
    "minCount": 5,
    "timeoutMs": 15000,
    "settleMs": 500
  },
  "list": {
    "rows": "article.product_pod",
    "fields": {
      "title": { "type": "attr", "selector": "h3 a", "attr": "title" },
      "price": { "type": "text", "selector": ".price_color" },
      "stock": { "type": "text", "selector": ".availability" },
      "url": { "type": "attr", "selector": "h3 a", "attr": "href", "absolute": true }
    }
  },
  "pagination": { "type": "link", "next": "li.next a", "maxPages": 3 },
  "expect": { "minRowsPerPage": 10 }
}

# Copy to .env next to docker-compose.yml. Everything here has a working default: an installation with
# no .env at all starts and runs. Nothing in this file is a secret except the two marked as such.

# ---- the door ----------------------------------------------------------------------------------
# Where the web view listens. The compose file binds it to 127.0.0.1 on the host regardless, because
# the view can run robots and rewrite them — put a tunnel or a tailnet in front of it, not the internet.
HOST=0.0.0.0
PORT=5544

# SECRET. Signs the session tokens. Leave it unset and one is generated into secrets/jwt.key on first
# start, which is the better option: a key in a file is not a key in a process listing.
# RATATOSK_JWT_SECRET=
# How long a sign-in lasts, in seconds. Default is 30 days.
# RATATOSK_TOKEN_TTL=2592000

# ---- models ------------------------------------------------------------------------------------
# API keys are NOT set here. Each account adds its own in the web view, and it is stored hashed per
# account — one installation, several people, no shared key in a file.
#
# Which model a new account starts with.
RATATOSK_MODEL=openai/gpt-5-nano
# Where to go when the chosen model is rate-limited mid-build, in order.
# RATATOSK_FALLBACK_MODELS=deepseek/deepseek-v4-flash,mistralai/mistral-nemo
# Any OpenAI-compatible endpoint works — a local one included.
# RATATOSK_LLM_URL=https://openrouter.ai/api/v1

# ---- browsers ----------------------------------------------------------------------------------
# One browser per account, capped. A headed Chromium is not free.
RATATOSK_MAX_BROWSERS=3
# Run the browser headed under Xvfb. Slower and heavier, and some sites answer a headless browser with
# a challenge they do not show a headed one.
# RATATOSK_HEADED=1
# How long a hand-driven browser session stays open with nobody touching it, in ms.
# RATATOSK_TAKEOVER_MS=900000

# ---- logs --------------------------------------------------------------------------------------
# debug | info | warn | error. One JSON line per event on stdout; `debug` adds browser and live-view
# chatter. Secrets are never logged and a test asserts it.
RATATOSK_LOG=info

# ---- what an installation keeps ----------------------------------------------------------------
# Paths inside the container; the compose file maps them to folders next to it. Change them only if you
# are running without compose.
# RATATOSK_ROBOTS=robots
# RATATOSK_PROFILES=profiles
# RATATOSK_HISTORY=history
# RATATOSK_MEMORY=memory
# RATATOSK_RESULTS=results
# How many runs of each scraper keep their rows on disk. Enough to compare today with last week.
# RATATOSK_RESULTS_KEEP=20
# RATATOSK_USERS=secrets/users.json
# RATATOSK_TG_SESSION=secrets/telegram.json
# How many runs per account are kept in the history.
# RATATOSK_HISTORY_KEEP=2000

# ---- tuning you will probably never touch ------------------------------------------------------
# How many unclaimed rows per run may be put to a model, when a rule asks for that. This is the only
# part of a run that costs money; it is bounded so a channel that suddenly posts a thousand messages
# cannot spend a thousand times more.
# RATATOSK_JUDGE_PER_RUN=40
# How many sample messages a rule is written from, and how much of a row identifies it in the memory.
# RATATOSK_SIFT_SHOWN=80
# RATATOSK_IDENTITY_HEAD=200

# ---- command line, against an installation that has accounts -----------------------------------
# SECRET. A key from the web view, so cli.js knows whose robots it is running.
# RATATOSK_TOKEN=rtk_...
